---
layout: layouts/base.njk
title: SST Adventure
description: An interactive, branching walkthrough of Separable Shape Tensors.
---
<div id="sst-app" class="sst" data-start="shapes-of-science">
  <header class="sst-bar">
    <div class="sst-bar-left">
      <span class="sst-act" id="sst-act">SST</span>
      <span class="sst-title" id="sst-scene-title">explore the math</span>
    </div>
    <div class="sst-bar-right">
      <a class="sst-btn" href="/sst/map/">map</a>
      <button type="button" class="sst-btn" id="sst-restart" aria-label="Restart from the beginning">restart</button>
      <button type="button" class="sst-btn" id="sst-fullscreen" aria-label="Toggle fullscreen">⛶</button>
    </div>
  </header>

  <div class="sst-transcript" id="sst-transcript" aria-live="polite"></div>

  <noscript><p>This interactive walkthrough requires JavaScript.</p></noscript>
</div>
