{
  "name": "zgrey-github-io",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx @11ty/eleventy --serve",
    "build": "npx @11ty/eleventy",
    "audit": "npm audit --audit-level=high",
    "lint": "eslint .",
    "html-validate": "html-validate \"_site/**/*.html\"",
    "gitleaks": "gitleaks detect --source . --redact --report-path=gitleaks-report.json"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "eslint": "~8.57.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "html-validate": "^8.0.0",
    "js-yaml": "^4.2.0"
  },
  "comments": {
    "overrides": "Force js-yaml >=4.2.0 to patch CVE-2026-53550 (GHSA-h67p-54hq-rp68). gray-matter@4.0.3 pins js-yaml ^3.13.1; we override it AND set a js-yaml 4.x front-matter engine in eleventy.config.js (gray-matter's default calls the removed safeLoad)."
  },
  "overrides": {
    "js-yaml": "^4.2.0"
  }
}
